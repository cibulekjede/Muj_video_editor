<UserControl x:Class="MujVideoEditor.Controls.TimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:MujVideoEditor.Models">
    <UserControl.Resources>
        <ItemsPanelTemplate x:Key="TrackPanel">
            <StackPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>

        <!-- Klip ve stope Video (video nebo obrazek) -->
        <DataTemplate x:Key="VideoClipTemplate" DataType="{x:Type models:TimelineClip}">
            <Grid Width="{Binding Width}" Background="Transparent" Cursor="Hand" ToolTip="{Binding Media.Name}"
                  MouseLeftButtonDown="Clip_MouseLeftButtonDown">
                <Border CornerRadius="4" Margin="0,0,1,0" Background="#24405E"/>
                <!-- Filmovy pas z nahledoveho obrazku -->
                <Border CornerRadius="4" Margin="0,0,1,0">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Media.Thumbnail}" Stretch="UniformToFill" TileMode="Tile"
                                    ViewportUnits="Absolute" Viewport="0,0,118,66" AlignmentX="Left"/>
                    </Border.Background>
                </Border>
                <Border Background="#99000000" CornerRadius="3" Padding="5,1" Margin="5,4"
                        HorizontalAlignment="Left" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Media.Name}" FontSize="11" Foreground="White"
                                   MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding DurationText}" FontSize="11" Foreground="#C8C8CE" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>
                <Border x:Name="Frame" CornerRadius="4" Margin="0,0,1,0" BorderThickness="2"
                        BorderBrush="Transparent" IsHitTestVisible="False"/>
                <Border x:Name="LeftHandle" Tag="Left" Width="8" HorizontalAlignment="Left" CornerRadius="4,0,0,4"
                        Background="Transparent" Cursor="SizeWE" MouseLeftButtonDown="TrimHandle_MouseLeftButtonDown"/>
                <Border x:Name="RightHandle" Tag="Right" Width="8" HorizontalAlignment="Right" CornerRadius="0,4,4,0"
                        Margin="0,0,1,0" Background="Transparent" Cursor="SizeWE"
                        MouseLeftButtonDown="TrimHandle_MouseLeftButtonDown"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Frame" Property="BorderBrush" Value="White"/>
                    <Setter TargetName="LeftHandle" Property="Background" Value="White"/>
                    <Setter TargetName="RightHandle" Property="Background" Value="White"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Klip ve stope Zvuk -->
        <DataTemplate x:Key="AudioClipTemplate" DataType="{x:Type models:TimelineClip}">
            <Grid Width="{Binding Width}" Background="Transparent" Cursor="Hand" ToolTip="{Binding Media.Name}"
                  MouseLeftButtonDown="Clip_MouseLeftButtonDown">
                <Border CornerRadius="4" Margin="0,0,1,0" Background="#1D5446"/>
                <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center" ClipToBounds="True">
                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#9FE6CF"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Media.Name}" FontSize="11" Foreground="White" Margin="6,0,0,0"
                               MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding DurationText}" FontSize="11" Foreground="#9FC9BC" Margin="8,0,0,0"/>
                </StackPanel>
                <Border x:Name="Frame" CornerRadius="4" Margin="0,0,1,0" BorderThickness="2"
                        BorderBrush="Transparent" IsHitTestVisible="False"/>
                <Border x:Name="LeftHandle" Tag="Left" Width="8" HorizontalAlignment="Left" CornerRadius="4,0,0,4"
                        Background="Transparent" Cursor="SizeWE" MouseLeftButtonDown="TrimHandle_MouseLeftButtonDown"/>
                <Border x:Name="RightHandle" Tag="Right" Width="8" HorizontalAlignment="Right" CornerRadius="0,4,4,0"
                        Margin="0,0,1,0" Background="Transparent" Cursor="SizeWE"
                        MouseLeftButtonDown="TrimHandle_MouseLeftButtonDown"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Frame" Property="BorderBrush" Value="White"/>
                    <Setter TargetName="LeftHandle" Property="Background" Value="White"/>
                    <Setter TargetName="RightHandle" Property="Background" Value="White"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- ===== Nastroje ===== -->
        <Border DockPanel.Dock="Top" Height="44" Padding="8,0"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="UndoButton" Style="{StaticResource IconButton}" Content="&#xE7A7;"
                            ToolTip="Zpět (Ctrl+Z)" Click="UndoButton_Click"/>
                    <Button x:Name="RedoButton" Style="{StaticResource IconButton}" Content="&#xE7A6;"
                            ToolTip="Znovu (Ctrl+Y)" Click="RedoButton_Click"/>
                    <Rectangle Width="1" Height="18" Fill="{StaticResource BorderBrush}" Margin="8,0"/>
                    <Button x:Name="SplitButton" Style="{StaticResource IconButton}" Content="&#xE8C6;"
                            ToolTip="Rozdělit na pozici přehrávání (Ctrl+B)" Click="SplitButton_Click"/>
                    <Button x:Name="DeleteButton" Style="{StaticResource IconButton}" Content="&#xE74D;"
                            ToolTip="Smazat vybraný klip (Delete)" Click="DeleteButton_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource IconButton}" Content="&#xE71F;" ToolTip="Oddálit (Ctrl+kolečko)"
                            Click="ZoomOut_Click"/>
                    <Slider x:Name="ZoomSlider" Width="140" Minimum="0" Maximum="90" Value="40"
                            VerticalAlignment="Center" Margin="4,0" ValueChanged="ZoomSlider_ValueChanged"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8A3;" ToolTip="Přiblížit (Ctrl+kolečko)"
                            Click="ZoomIn_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="96"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Popisky stop ===== -->
            <StackPanel Grid.Column="0" Margin="10,36,0,0">
                <StackPanel Height="66" Orientation="Horizontal">
                    <TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    <TextBlock Text="Video" Style="{StaticResource SecondaryText}" FontSize="12"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel Height="40" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                    <TextBlock Text="Zvuk" Style="{StaticResource SecondaryText}" FontSize="12"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- ===== Stopy ===== -->
            <ScrollViewer x:Name="Scroller" Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled" Focusable="False"
                          ScrollChanged="Scroller_ScrollChanged" PreviewMouseWheel="Scroller_PreviewMouseWheel">
                <Grid x:Name="ContentGrid" HorizontalAlignment="Left" Background="Transparent" AllowDrop="True"
                      MouseLeftButtonDown="ContentGrid_MouseLeftButtonDown" MouseMove="ContentGrid_MouseMove"
                      MouseLeftButtonUp="ContentGrid_MouseLeftButtonUp" LostMouseCapture="ContentGrid_LostMouseCapture"
                      DragOver="ContentGrid_DragOver" Drop="ContentGrid_Drop">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26"/>  <!-- Casove pravitko -->
                        <RowDefinition Height="10"/>
                        <RowDefinition Height="66"/>  <!-- Video -->
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="40"/>  <!-- Zvuk -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Canvas x:Name="RulerCanvas" Grid.Row="0" ClipToBounds="True"/>

                    <Border Grid.Row="2" Background="#17171A" CornerRadius="4"/>
                    <Border Grid.Row="4" Background="#17171A" CornerRadius="4"/>

                    <ItemsControl x:Name="VideoTrack" Grid.Row="2" HorizontalAlignment="Left"
                                  ItemsPanel="{StaticResource TrackPanel}" ItemTemplate="{StaticResource VideoClipTemplate}"/>
                    <ItemsControl x:Name="AudioTrack" Grid.Row="4" HorizontalAlignment="Left"
                                  ItemsPanel="{StaticResource TrackPanel}" ItemTemplate="{StaticResource AudioClipTemplate}"/>

                    <!-- Prazdna casova osa -->
                    <Grid x:Name="EmptyHint" Grid.Row="2" IsHitTestVisible="False">
                        <Rectangle RadiusX="4" RadiusY="4" Stroke="{StaticResource BorderBrush}"
                                   StrokeThickness="1" StrokeDashArray="4 3"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0">
                            <TextBlock Text="&#xE8B2;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Přetáhni sem materiál z knihovny médií a začni vytvářet" FontSize="13"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Ukazatel pozice prehravani -->
                    <Canvas Grid.RowSpan="6" IsHitTestVisible="False">
                        <Grid x:Name="PlayheadMarker" Width="11" Height="{Binding ActualHeight, ElementName=ContentGrid}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Width="11" Height="14" CornerRadius="2,2,5,5" Background="{StaticResource TextPrimary}"
                                    Margin="0,4,0,0"/>
                            <Rectangle Grid.Row="1" Width="1" Fill="{StaticResource TextPrimary}"/>
                        </Grid>
                    </Canvas>
                </Grid>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
