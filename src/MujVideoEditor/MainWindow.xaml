<Window x:Class="MujVideoEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MujVideoEditor"
        xmlns:models="clr-namespace:MujVideoEditor.Models"
        xmlns:controls="clr-namespace:MujVideoEditor.Controls"
        mc:Ignorable="d"
        PreviewKeyDown="Window_PreviewKeyDown"
        Title="Můj video editor" Height="900" Width="1600"
        MinHeight="640" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI">

    <!-- Vlastni tmava titulkova lista misto systemove -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Dlazdice v knihovne medii -->
        <Style x:Key="MediaTileContainer" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="{Binding FilePath}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="2" CornerRadius="6" Padding="4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="MediaTile" DataType="{x:Type models:MediaItem}">
            <StackPanel Width="120">
                <Grid Height="68">
                    <Border Background="{StaticResource CardBackground}" CornerRadius="4"/>
                    <TextBlock Text="{Binding KindGlyph}" FontFamily="{StaticResource IconFont}" FontSize="22"
                               Foreground="{StaticResource TextSecondary}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <!-- Nahled prekryje ikonu, jakmile se nacte -->
                    <Border CornerRadius="4">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <!-- Hvezdicka u oblibenych -->
                    <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#FFC83D"
                               Margin="5" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!-- Tlacitko + pro pridani na casovou osu (ukaze se pri najeti mysi) -->
                    <Button Width="20" Height="20" Margin="4" Cursor="Hand" ToolTip="Přidat na časovou osu"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Click="AddTileToTimeline_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="10" Background="{StaticResource Accent}">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Hidden"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Border Background="#B0000000" CornerRadius="3" Padding="4,1" Margin="4"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding DurationText}" FontSize="10" Foreground="White"/>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DurationText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>
                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource TextPrimary}"
                           TextTrimming="CharacterEllipsis" Margin="2,6,2,0"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>   <!-- Titulkova lista -->
            <RowDefinition Height="*"/>    <!-- Panely -->
        </Grid.RowDefinitions>

        <!-- ===== Titulkova lista ===== -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="15"
                           Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="Můj video editor" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="8,0,16,0"/>
                <Button x:Name="MenuButton" Style="{StaticResource ToolButton}" Padding="10,4" FontSize="12"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="MenuButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Nabídka"/>
                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9"
                                   VerticalAlignment="Center" Margin="6,1,0,0"/>
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Nový projekt" InputGestureText="Ctrl+N" Click="NewProject_Click"/>
                            <MenuItem Header="Otevřít projekt…" InputGestureText="Ctrl+O" Click="OpenProject_Click"/>
                            <Separator/>
                            <MenuItem Header="Uložit" InputGestureText="Ctrl+S" Click="SaveProject_Click"/>
                            <MenuItem Header="Uložit jako…" InputGestureText="Ctrl+Shift+S" Click="SaveProjectAs_Click"/>
                            <Separator/>
                            <MenuItem Header="Importovat média…" InputGestureText="Ctrl+I" Click="Import_Click"/>
                            <MenuItem Header="Exportovat video…" InputGestureText="Ctrl+E" Click="Export_Click"/>
                            <Separator/>
                            <MenuItem Header="Ukončit" Click="Close_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </StackPanel>

            <TextBlock x:Name="ProjectTitle" Text="Nový projekt" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource AccentButton}" Padding="12,5" Margin="0,0,12,0"
                        VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="Export_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE898;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Exportovat"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimalizovat"/>
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;"
                        Click="Maximize_Click" ToolTip="Maximalizovat"/>
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Zavřít"/>
            </StackPanel>
        </Grid>

        <!-- ===== Panely ===== -->
        <Grid Grid.Row="1" Margin="6,0,6,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="300"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="400" MinHeight="180"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="540" MinWidth="380"/>  <!-- Media -->
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*" MinWidth="360"/>    <!-- Prehravac -->
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="500" MinWidth="280"/>  <!-- Podrobnosti -->
                </Grid.ColumnDefinitions>

                <!-- ===== Levy panel: media ===== -->
                <Border Grid.Column="0" Style="{StaticResource Panel}">
                    <DockPanel>
                        <!-- Zalozky kategorii -->
                        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                Padding="6,4">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="MediaTab" Style="{StaticResource CategoryTab}" Tag="&#xE714;" Content="Média"
                                             IsChecked="True" Checked="CategoryTab_Checked"/>
                                <RadioButton x:Name="AudioTab" Style="{StaticResource CategoryTab}" Tag="&#xE8D6;" Content="Zvuk"
                                             Checked="CategoryTab_Checked"/>
                                <RadioButton x:Name="TextTab" Style="{StaticResource CategoryTab}" Tag="&#xE8D2;" Content="Text"
                                             Checked="CategoryTab_Checked"/>
                                <RadioButton Style="{StaticResource CategoryTab}" Tag="&#xE76E;" Content="Nálepky" Checked="CategoryTab_Checked"/>
                                <RadioButton Style="{StaticResource CategoryTab}" Tag="&#xE945;" Content="Efekty" Checked="CategoryTab_Checked"/>
                                <RadioButton x:Name="TransitionsTab" Style="{StaticResource CategoryTab}" Tag="&#xE8AB;" Content="Přechody"
                                             Checked="CategoryTab_Checked"/>
                                <RadioButton x:Name="SubtitlesTab" Style="{StaticResource CategoryTab}" Tag="&#xE7F0;" Content="Titulky"
                                             Checked="CategoryTab_Checked"/>
                                <RadioButton Style="{StaticResource CategoryTab}" Tag="&#xE71C;" Content="Filtry" Checked="CategoryTab_Checked"/>
                            </StackPanel>
                        </Border>

                        <Grid>
                        <!-- ===== Kategorie Media ===== -->
                        <Grid x:Name="MediaCategoryPanel">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Podnabidka -->
                            <Border Grid.Column="0" Background="{StaticResource SubPanelBackground}" Padding="8,10">
                                <StackPanel>
                                    <RadioButton x:Name="FilterAll" Style="{StaticResource NavItem}" Content="Vše" Tag="All"
                                                 IsChecked="True" Checked="LibraryFilter_Checked"/>
                                    <RadioButton Style="{StaticResource NavItem}" Content="Videa" Tag="Video" Checked="LibraryFilter_Checked"/>
                                    <RadioButton Style="{StaticResource NavItem}" Content="Obrázky" Tag="Image" Checked="LibraryFilter_Checked"/>
                                    <RadioButton x:Name="FilterAudio" Style="{StaticResource NavItem}" Content="Zvuk" Tag="Audio"
                                                 Checked="LibraryFilter_Checked"/>
                                    <RadioButton Style="{StaticResource NavItem}" Tag="Favorite" Checked="LibraryFilter_Checked">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                       Foreground="#FFC83D" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="Oblíbené"/>
                                        </StackPanel>
                                    </RadioButton>
                                    <TextBlock x:Name="LibraryFilterEmpty" Visibility="Collapsed" TextWrapping="Wrap"
                                               Style="{StaticResource SecondaryText}" FontSize="11" Margin="10,8,0,0"
                                               Text="V této skupině zatím nic není."/>
                                </StackPanel>
                            </Border>

                            <!-- Knihovna medii (sem lze pretahnout soubory) -->
                            <Grid Grid.Column="1" Background="Transparent" AllowDrop="True"
                                  DragOver="MediaArea_DragOver" Drop="MediaArea_Drop">

                                <!-- Prazdna knihovna: velka plocha pro import -->
                                <Border x:Name="EmptyImportCard" Margin="14" Background="{StaticResource CardBackground}"
                                        CornerRadius="6" Cursor="Hand" VerticalAlignment="Top" Height="250"
                                        MouseLeftButtonUp="EmptyImportCard_MouseLeftButtonUp">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource Accent}">
                                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Importovat" FontSize="18" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Přetáhni sem videa, fotky a zvukové soubory." Style="{StaticResource SecondaryText}"
                                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Naimportovana media -->
                                <DockPanel x:Name="MediaListPanel" Visibility="Collapsed">
                                    <Button DockPanel.Dock="Top" Style="{StaticResource ToolButton}" HorizontalAlignment="Left"
                                            Margin="14,14,14,6" Click="Import_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                       Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Importovat"/>
                                        </StackPanel>
                                    </Button>
                                    <ListBox x:Name="MediaList" Background="Transparent" BorderThickness="0" Padding="8,0"
                                             ItemContainerStyle="{StaticResource MediaTileContainer}"
                                             ItemTemplate="{StaticResource MediaTile}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             SelectionChanged="MediaList_SelectionChanged"
                                             PreviewMouseLeftButtonDown="MediaList_PreviewMouseLeftButtonDown"
                                             PreviewMouseMove="MediaList_PreviewMouseMove">
                                        <ListBox.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Přidat na časovou osu" Click="AddToTimeline_Click"/>
                                                <MenuItem x:Name="FavoriteMenuItem" Header="Přidat do oblíbených" Click="ToggleFavorite_Click"/>
                                                <Separator/>
                                                <MenuItem Header="Odstranit z projektu" Click="RemoveMedia_Click"/>
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                    </ListBox>
                                </DockPanel>
                            </Grid>
                        </Grid>

                        <!-- ===== Kategorie Text: predlohy textu ===== -->
                        <ScrollViewer x:Name="TextCategoryPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16">
                                <TextBlock Text="Přidat text" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Klikni na předlohu a text se přidá na pozici přehrávání."
                                           Style="{StaticResource SecondaryText}" Margin="0,4,0,12"/>
                                <WrapPanel>
                                    <WrapPanel.Resources>
                                        <Style x:Key="PresetTile" TargetType="Button">
                                            <Setter Property="Width" Value="150"/>
                                            <Setter Property="Height" Value="84"/>
                                            <Setter Property="Margin" Value="0,0,10,10"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="#111114" CornerRadius="6" BorderThickness="2"
                                                                BorderBrush="Transparent">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </WrapPanel.Resources>
                                    <Button Style="{StaticResource PresetTile}" Tag="Default" Click="TextPreset_Click" ToolTip="Výchozí text">
                                        <TextBlock Text="Tvůj text" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                    </Button>
                                    <Button Style="{StaticResource PresetTile}" Tag="Subtitle" Click="TextPreset_Click" ToolTip="Titulek dole s pozadím">
                                        <Border Background="#80000000" Padding="6,2">
                                            <TextBlock Text="Titulek" FontSize="16" Foreground="White"/>
                                        </Border>
                                    </Button>
                                    <Button Style="{StaticResource PresetTile}" Tag="Headline" Click="TextPreset_Click" ToolTip="Velký nadpis">
                                        <TextBlock Text="NADPIS" FontFamily="Impact" FontSize="28" Foreground="White"/>
                                    </Button>
                                    <Button Style="{StaticResource PresetTile}" Tag="Yellow" Click="TextPreset_Click" ToolTip="Žlutý text">
                                        <TextBlock Text="Wow!" FontFamily="Arial" FontSize="26" FontWeight="Bold" Foreground="#FFDD00"/>
                                    </Button>
                                    <Button Style="{StaticResource PresetTile}" Tag="Comic" Click="TextPreset_Click" ToolTip="Vtipný text">
                                        <TextBlock Text="Haha!" FontFamily="Comic Sans MS" FontSize="22" FontWeight="Bold" Foreground="#FF8AD8"/>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ===== Kategorie Prechody ===== -->
                        <StackPanel x:Name="TransitionsCategoryPanel" Visibility="Collapsed" Margin="16">
                            <TextBlock Text="Přechody" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource SecondaryText}" Margin="0,4,0,14"
                                       Text="Prolnutí přes černou: konec jednoho klipu ztmavne a další se z černé rozjasní. Zvuk se plynule ztiší a zesílí. U jednotlivého klipu ho nastavíš vpravo, když na klip klikneš."/>
                            <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Left" Padding="14,7" Click="FadeAllCuts_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8AB;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Prolnout všechny střihy (0,5 s)"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Padding="14,7" Margin="0,10,0,0"
                                    Content="Odebrat všechny přechody" Click="RemoveAllFades_Click"/>
                        </StackPanel>

                        <!-- ===== Kategorie, ktere jeste nejsou hotove ===== -->
                        <StackPanel x:Name="ComingSoonPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE823;" FontFamily="{StaticResource IconFont}" FontSize="32"
                                       Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Připravujeme" FontSize="14" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                            <TextBlock Text="Tahle část editoru ještě není hotová." Style="{StaticResource SecondaryText}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

                <!-- ===== Prostredni panel: prehravac ===== -->
                <Border Grid.Column="2" Style="{StaticResource Panel}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                            <TextBlock x:Name="PlayerTitle" Text="Přehrávač" Style="{StaticResource PanelTitle}"/>
                        </Border>

                        <!-- Ovladani prehravani -->
                        <Grid DockPanel.Dock="Bottom" Height="48" Margin="12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="CurrentTimeText" Text="00:00:00:00" Foreground="{StaticResource Accent}"
                                           FontFamily="Consolas" FontSize="12"/>
                                <TextBlock Text=" / " Foreground="{StaticResource TextSecondary}" FontFamily="Consolas" FontSize="12"/>
                                <TextBlock x:Name="TotalTimeText" Text="00:00:00:00" Foreground="{StaticResource TextSecondary}"
                                           FontFamily="Consolas" FontSize="12"/>
                            </StackPanel>
                            <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Content="&#xE768;"
                                    ToolTip="Přehrát (mezerník)" HorizontalAlignment="Center" FontSize="18"
                                    IsEnabled="False" Click="PlayButton_Click"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="AspectButton" Style="{StaticResource ToolButton}" Content="16:9" Padding="8,3" FontSize="11"
                                        Background="Transparent" ToolTip="Poměr stran videa" Click="AspectButton_Click">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="16:9  (YouTube, na šířku)" Tag="16:9" Click="AspectMenu_Click"/>
                                            <MenuItem Header="9:16  (TikTok, Reels, Shorts)" Tag="9:16" Click="AspectMenu_Click"/>
                                            <MenuItem Header="1:1  (čtverec, Instagram)" Tag="1:1" Click="AspectMenu_Click"/>
                                            <MenuItem Header="4:3" Tag="4:3" Click="AspectMenu_Click"/>
                                            <MenuItem Header="3:4" Tag="3:4" Click="AspectMenu_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                                <Button Style="{StaticResource IconButton}" Content="&#xE740;" ToolTip="Celá obrazovka (F)"
                                        Click="Fullscreen_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- Posuvnik pozice -->
                        <Slider x:Name="SeekSlider" DockPanel.Dock="Bottom" Margin="12,0" IsEnabled="False"
                                IsMoveToPointEnabled="True" Minimum="0" Maximum="1"
                                PreviewMouseLeftButtonDown="SeekSlider_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="SeekSlider_PreviewMouseLeftButtonUp"
                                ValueChanged="SeekSlider_ValueChanged"/>

                        <!-- Plocha nahledu 16:9 -->
                        <Viewbox Margin="16,16,16,8" Stretch="Uniform">
                            <Grid x:Name="PreviewCanvas" Width="1600" Height="900" Background="#0A0A0B"
                                  MouseLeftButtonDown="PreviewCanvas_MouseLeftButtonDown">
                                <!-- Dva prehravace videa: zatimco jeden hraje, druhy si nacita dalsi klip -->
                                <MediaElement x:Name="PlayerB" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                              ScrubbingEnabled="True" Stretch="Uniform" Opacity="0" IsMuted="True"
                                              MediaOpened="PlayerB_MediaOpened" MediaFailed="Player_MediaFailed"/>
                                <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                              ScrubbingEnabled="True" Stretch="Uniform"
                                              MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded"
                                              MediaFailed="Player_MediaFailed"/>
                                <!-- Prehrava stopu Zvuk z casove osy (neni videt) -->
                                <MediaElement x:Name="AudioPlayer" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                              Width="0" Height="0" MediaOpened="AudioPlayer_MediaOpened"/>
                                <Image x:Name="PreviewImage" Stretch="Uniform" Visibility="Collapsed"/>
                                <StackPanel x:Name="AudioPlaceholder" Visibility="Collapsed"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="140"
                                               Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="AudioNameText" FontSize="40" Foreground="{StaticResource TextPrimary}"
                                               HorizontalAlignment="Center" Margin="0,30,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="PreviewMessage" Visibility="Collapsed" FontSize="40"
                                           Foreground="{StaticResource TextSecondary}" TextAlignment="Center"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <!-- Texty z casove osy (lze je tahat mysi) -->
                                <Canvas x:Name="TextLayer" ClipToBounds="True"
                                        MouseMove="TextLayer_MouseMove" MouseLeftButtonUp="TextLayer_MouseLeftButtonUp"
                                        LostMouseCapture="TextLayer_LostMouseCapture"/>
                            </Grid>
                        </Viewbox>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

                <!-- ===== Pravy panel: podrobnosti ===== -->
                <Border Grid.Column="4" Style="{StaticResource Panel}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}">
                            <TextBlock x:Name="DetailsTitle" Text="Podrobnosti" Style="{StaticResource PanelTitle}"
                                       Foreground="{StaticResource Accent}"/>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                            <!-- ===== Editor textu (kdyz je vybrany textovy klip) ===== -->
                            <StackPanel x:Name="TextEditorPanel" Visibility="Collapsed" Margin="14,16,14,16">
                                <TextBlock Text="Text" Style="{StaticResource SecondaryText}" Margin="0,0,0,6"/>
                                <TextBox x:Name="TextContentBox" AcceptsReturn="True" TextWrapping="Wrap" Height="76"
                                         VerticalScrollBarVisibility="Auto" TextChanged="TextContentBox_TextChanged"/>

                                <TextBlock Text="Písmo" Style="{StaticResource SecondaryText}" Margin="0,16,0,6"/>
                                <WrapPanel x:Name="FontChoices"/>

                                <DockPanel Margin="0,10,0,6">
                                    <TextBlock x:Name="FontSizeText" DockPanel.Dock="Right" Style="{StaticResource SecondaryText}"/>
                                    <TextBlock Text="Velikost" Style="{StaticResource SecondaryText}"/>
                                </DockPanel>
                                <Slider x:Name="FontSizeSlider" Minimum="20" Maximum="250" ValueChanged="FontSizeSlider_ValueChanged"/>

                                <TextBlock Text="Barva" Style="{StaticResource SecondaryText}" Margin="0,16,0,6"/>
                                <WrapPanel x:Name="ColorChoices"/>

                                <TextBlock Text="Styl" Style="{StaticResource SecondaryText}" Margin="0,16,0,6"/>
                                <WrapPanel>
                                    <CheckBox x:Name="BoldCheck" Style="{StaticResource ChipCheck}" Content="Tučné" Click="TextStyle_Click"/>
                                    <CheckBox x:Name="ShadowCheck" Style="{StaticResource ChipCheck}" Content="Stín" Click="TextStyle_Click"/>
                                    <CheckBox x:Name="BackgroundCheck" Style="{StaticResource ChipCheck}" Content="Pozadí" Click="TextStyle_Click"/>
                                </WrapPanel>

                                <TextBlock Text="Pozice" Style="{StaticResource SecondaryText}" Margin="0,16,0,6"/>
                                <WrapPanel>
                                    <Button Style="{StaticResource ToolButton}" Content="Nahoře" Tag="0.12" Margin="0,0,6,0" Click="TextPosition_Click"/>
                                    <Button Style="{StaticResource ToolButton}" Content="Uprostřed" Tag="0.5" Margin="0,0,6,0" Click="TextPosition_Click"/>
                                    <Button Style="{StaticResource ToolButton}" Content="Dole" Tag="0.88" Click="TextPosition_Click"/>
                                </WrapPanel>
                                <TextBlock Text="Text můžeš v náhledu i přetáhnout myší." Style="{StaticResource SecondaryText}"
                                           Margin="0,8,0,0"/>
                            </StackPanel>

                            <!-- ===== Upravy klipu (video, obrazek, zvuk) ===== -->
                            <StackPanel x:Name="ClipEditorPanel" Visibility="Collapsed" Margin="14,16,14,0">
                                <StackPanel x:Name="VolumeSection">
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock x:Name="VolumeText" DockPanel.Dock="Right" Style="{StaticResource SecondaryText}"/>
                                        <TextBlock Text="Hlasitost" Style="{StaticResource SecondaryText}"/>
                                    </DockPanel>
                                    <DockPanel>
                                        <CheckBox x:Name="MuteCheck" DockPanel.Dock="Right" Style="{StaticResource ChipCheck}"
                                                  Content="Ztlumit" Margin="10,0,0,0" Click="MuteCheck_Click"/>
                                        <Slider x:Name="VolumeSlider" Minimum="0" Maximum="200" VerticalAlignment="Center"
                                                ValueChanged="VolumeSlider_ValueChanged"/>
                                    </DockPanel>
                                </StackPanel>

                                <StackPanel x:Name="SpeedSection">
                                    <TextBlock Text="Rychlost" Style="{StaticResource SecondaryText}" Margin="0,16,0,6"/>
                                    <WrapPanel x:Name="SpeedChoices">
                                        <RadioButton Style="{StaticResource ChipRadio}" GroupName="Speed" Content="0,25×" Tag="0.25" Margin="0,0,6,6" Click="Speed_Click"/>
                                        <RadioButton Style="{StaticResource ChipRadio}" GroupName="Speed" Content="0,5×" Tag="0.5" Margin="0,0,6,6" Click="Speed_Click"/>
                                        <RadioButton Style="{StaticResource ChipRadio}" GroupName="Speed" Content="1×" Tag="1" Margin="0,0,6,6" Click="Speed_Click"/>
                                        <RadioButton Style="{StaticResource ChipRadio}" GroupName="Speed" Content="1,5×" Tag="1.5" Margin="0,0,6,6" Click="Speed_Click"/>
                                        <RadioButton Style="{StaticResource ChipRadio}" GroupName="Speed" Content="2×" Tag="2" Margin="0,0,6,6" Click="Speed_Click"/>
                                        <RadioButton Style="{StaticResource ChipRadio}" GroupName="Speed" Content="3×" Tag="3" Margin="0,0,6,6" Click="Speed_Click"/>
                                        <RadioButton Style="{StaticResource ChipRadio}" GroupName="Speed" Content="4×" Tag="4" Margin="0,0,6,6" Click="Speed_Click"/>
                                    </WrapPanel>
                                </StackPanel>

                                <TextBlock Text="Roztmívání na začátku" Style="{StaticResource SecondaryText}" Margin="0,16,0,6"/>
                                <WrapPanel x:Name="FadeInChoices">
                                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="FadeIn" Content="Žádné" Tag="0" Margin="0,0,6,6" Click="FadeIn_Click"/>
                                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="FadeIn" Content="0,5 s" Tag="0.5" Margin="0,0,6,6" Click="FadeIn_Click"/>
                                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="FadeIn" Content="1 s" Tag="1" Margin="0,0,6,6" Click="FadeIn_Click"/>
                                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="FadeIn" Content="2 s" Tag="2" Margin="0,0,6,6" Click="FadeIn_Click"/>
                                </WrapPanel>

                                <TextBlock Text="Zatmívání na konci" Style="{StaticResource SecondaryText}" Margin="0,10,0,6"/>
                                <WrapPanel x:Name="FadeOutChoices">
                                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="FadeOut" Content="Žádné" Tag="0" Margin="0,0,6,6" Click="FadeOut_Click"/>
                                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="FadeOut" Content="0,5 s" Tag="0.5" Margin="0,0,6,6" Click="FadeOut_Click"/>
                                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="FadeOut" Content="1 s" Tag="1" Margin="0,0,6,6" Click="FadeOut_Click"/>
                                    <RadioButton Style="{StaticResource ChipRadio}" GroupName="FadeOut" Content="2 s" Tag="2" Margin="0,0,6,6" Click="FadeOut_Click"/>
                                </WrapPanel>

                                <Rectangle Height="1" Fill="{StaticResource BorderBrush}" Margin="0,14,0,0"/>
                            </StackPanel>

                            <!-- Radky se plni z kodu: podrobnosti projektu, nebo vybraneho media -->
                            <ItemsControl x:Name="DetailsList" Margin="14,18,14,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Key}" Style="{StaticResource DetailLabel}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource DetailValue}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext"/>

            <!-- ===== Casova osa ===== -->
            <Border Grid.Row="2" Style="{StaticResource Panel}">
                <controls:TimelineView x:Name="TimelineEditor"/>
            </Border>
        </Grid>
    </Grid>
</Window>
